# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# The root is always the public holding page. The full site lives at /test and
# /demo behind this password.
#
# It ends up in the built JavaScript, so treat it as a keep-out sign rather
# than security. Nothing private may sit behind it.
VITE_DEMO_PASSWORD=acid1234

# Supabase — for the admin portal, availability and the media library.
# The anon key is designed to be public; row-level security is what protects
# the data. The service_role key must NEVER appear here or in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Web Analytics token — cookieless visit counts and countries.
# See src/lib/analytics.js for how to get one. Leave blank to collect nothing.
VITE_CF_ANALYTICS_TOKEN=
